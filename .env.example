# ==========================================
# DARUKAA.EARTH ENVIRONMENT CONFIGURATION
# ==========================================

# --- Backend Configuration ---
ENVIRONMENT=development
PROJECT_NAME="Darukaa.Earth Platform"
API_V1_STR="/api/v1"
SECRET_KEY=darukaa-super-secret-jwt-signing-key-change-in-production-2025
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (PostgreSQL with PostGIS extension)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=darukaa_earth
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/darukaa_earth
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/darukaa_earth

# CORS Settings (Comma separated)
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","https://darukaa.earth"]

# --- Frontend Configuration ---
VITE_API_BASE_URL=http://localhost:8000/api/v1
# Public Mapbox token or custom token
VITE_MAPBOX_TOKEN=your_mapbox_access_token_here
